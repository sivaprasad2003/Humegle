# =========================================
# Node.js & Dependencies
# =========================================
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
.pnp
.pnp.js

# =========================================
# Environment Variables & Secrets
# =========================================
# NEVER commit real environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# =========================================
# Next.js (Frontend)
# =========================================
apps/web/.next/
apps/web/out/
apps/web/build/
.vercel

# =========================================
# Backend & Build Outputs
# =========================================
apps/server/dist/
apps/server/build/
dist/
build/
*.tsbuildinfo

# =========================================
# Logs
# =========================================
logs/
*.log

# =========================================
# Prisma ORM
# =========================================
# (If using SQLite locally, ignore it. We are using Postgres, but this is safe)
*.db
*.db-journal
packages/database/dev.db

# =========================================
# OS & IDE Files
# =========================================
.DS_Store
*.swp
Thumbs.db
.idea/
.vscode/
.coverage
coverage/

# =========================================
# Ignore specific Docker data volumes
# =========================================
# Do not commit local database/redis files if mounted to the local filesystem
postgres-data/
redis-data/